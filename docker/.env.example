# Host user/group IDs for www-data inside the PHP container.
# Run `id -u` and `id -g` on the host and set the values below.
PUID=1000
PGID=1000

# Nginx
NGINX_PORT=8092

# PostgreSQL
POSTGRES_DB=traning-ps
POSTGRES_USER=traning-ps
POSTGRES_PASSWORD=secret
POSTGRES_PORT=2505

REDIS_PASSWORD=secret
REDIS_PORT=2506
